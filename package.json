{
  "name": "black-inventors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "deps:check": "npx npm-check-updates --format group",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run audit",
    "validate": "npm run format && npm run check"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "@remix-run/router": "^1.23.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^8.2.2",
    "core-js": "^3.37.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^16.1.0",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.2.0",
    "npm-check-updates": "^17.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
