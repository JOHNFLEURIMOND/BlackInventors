{
  "name": "aws-react-basic-app",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build",
    "server": "node server/index.js",
    "prettier": "prettier --write .",
    "restart": "npm run format && rm -rf package-lock.json && rm -rf node_modules && npm install npm-check-updates && ncu -u && npm install && npm run dev",
    "push": "npm run format && rm -rf package-lock.json && rm -rf node_modules && git add . && git commit -m 'bare bones' && git push",
    "kill": "sudo kill -9 `ps aux | grep node | grep -v grep | awk '{print $2}'`",
    "clean": "npm cache clean --force && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "styled-components": "^6.1.12"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "concurrently": "^8.2.2",
    "core-js": "^3.37.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "jsdom": "^25.0.0",
    "vitest": "^2.0.5",
    "vite": "^5.3.5"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
